{"type":"before","callId":"call@6","startTime":5188.667,"class":"BrowserContext","method":"addInitScript","params":{"source":"(function deterministicMedia() {\n  function videoTrack() {\n    const canvas = document.createElement(\"canvas\");\n    canvas.width = 320;\n    canvas.height = 180;\n    const context = canvas.getContext(\"2d\");\n    let frame = 0;\n    const draw = () => {\n      frame += 1;\n      context.fillStyle = `hsl(${frame % 360} 65% 45%)`;\n      context.fillRect(0, 0, canvas.width, canvas.height);\n      context.fillStyle = \"white\";\n      context.font = \"20px sans-serif\";\n      context.fillText(`Mosh E2E ${frame}`, 18, 92);\n    };\n    draw();\n    const interval = window.setInterval(draw, 100);\n    const track = canvas.captureStream(10).getVideoTracks()[0];\n    const stop = track.stop.bind(track);\n    track.stop = () => {\n      window.clearInterval(interval);\n      stop();\n    };\n    return track;\n  }\n  function audioTrack() {\n    const AudioContextCtor = window.AudioContext || window.webkitAudioContext;\n    const audio = new AudioContextCtor();\n    const oscillator = audio.createOscillator();\n    const gain = audio.createGain();\n    const destination = audio.createMediaStreamDestination();\n    oscillator.frequency.value = 220;\n    gain.gain.value = 0.04;\n    oscillator.connect(gain);\n    gain.connect(destination);\n    oscillator.start();\n    void audio.resume?.();\n    const track = destination.stream.getAudioTracks()[0];\n    const stop = track.stop.bind(track);\n    track.stop = () => {\n      try {\n        oscillator.stop();\n      } catch {}\n      void audio.close?.();\n      stop();\n    };\n    return track;\n  }\n  const mediaDevices = navigator.mediaDevices || {};\n  Object.defineProperty(mediaDevices, \"getUserMedia\", {\n    configurable: true,\n    writable: true,\n    value: async (constraints = {}) => new MediaStream([...(constraints.audio ? [audioTrack()] : []), ...(constraints.video ? [videoTrack()] : [])])\n  });\n  Object.defineProperty(mediaDevices, \"getDisplayMedia\", {\n    configurable: true,\n    writable: true,\n    value: async () => new MediaStream([videoTrack()])\n  });\n  try {\n    Object.defineProperty(navigator, \"mediaDevices\", {\n      configurable: true,\n      value: mediaDevices\n    });\n  } catch {}\n})(undefined)"},"stepId":"pw:api@27"}
