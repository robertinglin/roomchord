var cachedEmoji;
function matterhornAllEmoji() {
	if (cachedEmoji) return cachedEmoji;
	const emojis = [];
	for (const category of MATTERHORN_EMOJI_CATEGORIES) for (const subgroup of category.subgroups) for (const [emoji, name, codepoints, version, status] of subgroup.emojis) emojis.push({
		emoji,
		name,
		codepoints: codepoints.split(" "),
		version,
		status,
		category: category.label,
		categoryKey: category.key,
		subgroup: subgroup.label,
		subgroupKey: subgroup.key
	});
	cachedEmoji = emojis;
	return cachedEmoji;
}
function matterhornEmojiByCategory(categoryKey) {
	return matterhornAllEmoji().filter((emoji) => emoji.categoryKey === categoryKey);
}
function matterhornSearchEmoji(query, options = {}) {
	const normalized = query.trim().toLowerCase();
	const source = options.categoryKey ? matterhornEmojiByCategory(options.categoryKey) : matterhornAllEmoji();
	if (!normalized) return source;
	return source.filter((emoji) => {
		const codepoints = emoji.codepoints.join(" ").toLowerCase();
		return emoji.emoji === query || emoji.name.toLowerCase().includes(normalized) || emoji.category.toLowerCase().includes(normalized) || emoji.subgroup.toLowerCase().includes(normalized) || codepoints.includes(normalized) || codepoints.replace(/ /g, "").includes(normalized.replace(/\s+/g, ""));
	});
}
