	async function updateMediaRoom(room, mediaSettings) {
		if (view.joinedRoomId === room.id) holdDirectCallIfActive();
		else if (!await prepareDirectCallSwitch(room)) return;
		const baseMedia = {
			audio: mediaSettings.audio !== false,
			video: Boolean(mediaSettings.video),
			screen: Boolean(mediaSettings.screen)
		};
		const nextMedia = mediaSettings.voice ? {
			...baseMedia,
			voice: mediaSettings.voice
		} : mediaWithVoicePreferences(baseMedia, input.localVoicePreferences);
