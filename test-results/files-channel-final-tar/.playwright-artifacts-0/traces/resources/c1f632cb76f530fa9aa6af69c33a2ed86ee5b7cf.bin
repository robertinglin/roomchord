//#region src/entities/chat/model/actions/messageActions.ts
function messageActions(input) {
	const { live, ui, view } = input;
	const { dispatch, state } = live;
	async function sendChannelMessageToChannel(channelId, body, attachmentIds = [], customMediaRefs = []) {
		if (view.actorChatDisabled) return;
		const embeds = messageEmbeds(body);
		await dispatch("messageSend", {
			channelId,
			body,
			embeds,
			mentionIds: parseMentionedMemberIds(body, view.memberNamesById),
			attachmentIds,
			...customMediaRefs.length ? { customMediaRefs } : {}
		});
		for (const embed of embeds) {
			if (embed.provider === "link") continue;
			await dispatch("embedAdd", {
				scopeType: "channel",
				scopeId: channelId,
				url: embed.url,
				title: embed.title,
				provider: embed.provider
			});
		}
	}
	async function sendChannelMessage(body, attachmentIds = [], customMediaRefs = []) {
		if (!view.currentChannelId) return;
		await sendChannelMessageToChannel(view.currentChannelId, body, attachmentIds, customMediaRefs);
	}
	async function sendDirectMessageToThread(threadId, userIds, body, attachmentIds = [], customMediaRefs = []) {
		if (view.actorChatDisabled) return;
		try {
			await dispatch("directMessageSend", {
				userIds,
				...view.activeThread?.topicKey ? { topicKey: view.activeThread.topicKey } : {},
				body,
				attachmentIds,
				...customMediaRefs.length ? { customMediaRefs } : {}
			});
		} catch {
			return;
		}
		const committedThread = directThreadForUsers(live.state, userIds) || directThreadForUsers(state, userIds);
		if (committedThread) {
			ui.clearDraftDirectThread(committedThread.id);
			ui.showDirectThread(committedThread.id);
			ui.setActiveThreadId(committedThread.id);
			return;
		}
		ui.showDirectThread(threadId);
		ui.setActiveThreadId(threadId);
	}
	async function sendDirectMessage(body, attachmentIds = [], customMediaRefs = []) {
		if (!view.currentThreadId) return;
		const userIds = view.activeThread?.userIds;
		if (!userIds || userIds.length < 2) return;
		await sendDirectMessageToThread(view.currentThreadId, userIds, body, attachmentIds, customMediaRefs);
	}
	async function forwardMessage(message, target) {
		const channelId = "channelId" in message ? message.channelId : void 0;
		const source = message.threadId ? {
			kind: "direct.thread",
			scopeId: message.threadId,
			messageId: message.id
		} : channelId ? {
			kind: "channel",
			scopeId: channelId,
			messageId: message.id
		} : void 0;
		if (!source) return false;
		const destination = target.type === "channel" ? {
			kind: "channel",
			channelId: target.channelId
		} : {
			kind: "direct.thread",
			...target.threadId ? { threadId: target.threadId } : {},
			userIds: target.userIds,
			...target.topicKey ? { topicKey: target.topicKey } : {}
		};
		const sourceScope = {
			kind: source.kind,
			scopeId: source.scopeId
		};
		const targetScope = target.type === "channel" ? {
			kind: "channel",
			scopeId: target.channelId
		} : {
			kind: "direct.thread",
			scopeId: target.threadId
		};
		const needsAttachmentReshare = Boolean(message.attachmentIds?.length) && (sourceScope.kind !== targetScope.kind || sourceScope.scopeId !== targetScope.scopeId);
		try {
			if (needsAttachmentReshare) return await live.reshareForForward({
				source,
				target: destination
			});
			await live.forwardMessage({
				source,
				target: destination
			});
			return true;
		} catch (error) {
			if (error instanceof Error) return error.message;
			if (typeof error === "object" && error !== null && "message" in error) return String(error.message);
			return false;
		}
	}
	async function replyToMessage(replyToId, body, attachmentIds = [], customMediaRefs = []) {
		const directTarget = state.directMessages?.[replyToId];
		if (directTarget?.threadId && directTarget.userIds?.length) {
			await dispatch("directMessageReply", {
				userIds: directTarget.userIds,
				topicKey: directTarget.topicKey || void 0,
				replyToId,
				body,
				attachmentIds,
				...customMediaRefs.length ? { customMediaRefs } : {}
			});
			return;
		}
		if (!view.currentChannelId) return;
		if (view.actorChatDisabled) return;
		const mentionIds = parseMentionedMemberIds(body, view.memberNamesById);
		await dispatch("messageReply", {
			channelId: view.currentChannelId,
			replyToId,
			body,
			mentionIds,
			...customMediaRefs.length ? { customMediaRefs } : {}
		});
	}
	async function reactToMessage(messageId, emoji) {
		if (state.directMessages?.[messageId]) {
			await dispatch("directMessageReact", {
				messageId,
				emoji
			});
			return;
		}
		await dispatch("messageReact", {
			messageId,
			emoji
		});
	}
	async function pinMessage(messageId) {
		if (state.directMessages?.[messageId]) {
			await dispatch("directMessagePin", { messageId });
			return;
		}
		await dispatch("messagePin", { messageId });
	}
	async function unpinMessage(messageId) {
		if (state.directMessages?.[messageId]) {
			await dispatch("directMessageUnpin", { messageId });
			return;
		}
		await dispatch("messageUnpin", { messageId });
	}
	async function deleteMessage(messageId) {
		if (state.directMessages?.[messageId]) {
			await dispatch("directMessageDelete", { messageId });
			return;
		}
		await dispatch("messageDelete", { messageId });
	}
	async function editMessage(messageId, body) {
		if (state.directMessages?.[messageId]) {
			await dispatch("directMessageEdit", {
				messageId,
				body,
				embeds: messageEmbeds(body)
			});
			return;
		}
		await dispatch("messageEdit", {
			messageId,
			body,
			embeds: messageEmbeds(body)
		});
	}
	function closeDirectThread(threadId) {
		const nextThreads = view.threads.filter((thread) => thread.id !== threadId);
		ui.closeDirectThread({
			threadId,
			latestMessageAt: latestDirectMessageTime(state, threadId),
			nextThreadId: nextThreads[0]?.id
		});
	}
	async function openDirectThread(userIds) {
		console.error("[mosh] open direct thread", userIds, live.actor.memberId);
		const participants = Array.from(new Set([live.actor.memberId, ...userIds].filter(Boolean))).sort();
		if (participants.length < 2) return;
		const committedThread = directThreadForUsers(state, participants);
		if (committedThread) {
			ui.showDirectThread(committedThread.id);
			ui.setActiveThreadId(committedThread.id);
			ui.setActiveView("dm");
			ui.bumpComposerFocus();
			return;
		}
		let reservation;
		try {
			reservation = await live.reserveDirectThread({ userIds: participants });
			console.error("[mosh] direct-thread reservation ready", reservation);
		} catch (error) {
			console.error("[mosh] direct-thread reservation failed", error);
			return;
		}
		const reservedDraft = draftDirectThreadForUsers(live.actor.memberId, reservation.userIds, reservation.threadId);
		if (!reservedDraft) return;
		ui.showDirectThread(reservedDraft.id);
		ui.openDraftDirectThread(reservedDraft);
	}
	function openDirectThreadForMember(memberId) {
		return openDirectThread([memberId]);
	}
	return {
		closeDirectThread,
		deleteMessage,
		editMessage,
		forwardMessage,
		openDirectThreadForMember,
		pinMessage,
		reactToMessage,
		replyToMessage,
		sendChannelMessage,
		sendDirectMessage,
		unpinMessage
	};
}
