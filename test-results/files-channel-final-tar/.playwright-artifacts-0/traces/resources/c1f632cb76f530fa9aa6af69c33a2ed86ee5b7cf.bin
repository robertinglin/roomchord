ransparent;\n}\n\nbutton,\n\ninput,\n\nselect,\n\ntextarea {\n  font: inherit;\n}\n\nbutton {\n  border: 0;\n}\n\n.media-room,\n\n.primary-action,\n\n.ghost-action,\n\n.composer-send-button,\n\n.embed-icon-button,\n\n.message-forward-list button,\n\n.message-menu-reaction-row button {\n  border: 1px solid;\n  border-left-color: var(--dual-border-light);\n  border-top-color: var(--dual-border-light);\n  border-right-color: var(--dual-border-dark);\n  border-bottom-color: var(--dual-border-dark);\n}\n\n.context-menu-shroud {\n  position: fixed;\n  inset: 0;\n  z-index: 14;\n  display: block;\n  background: transparent;\n}\n\n.context-menu-popover {\n  position: relative;\n  z-index: 15;\n}\n\n.ui-icon {\n  width: 16px;\n  height: 16px;\n  display: inline-block;\n  flex: 0 0 auto;\n  color: currentColor;\n}\n\n.ui-icon :where(path, circle, rect, line, polyline, polygon) {\n  fill: none;\n  stroke: currentColor;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-width: 1.8;\n}\n\n.room-status-dot.connected {\n  background: var(--success);\n}\n\n.room-status-dot.error,\n\n.room-status-dot.offline {\n  background: var(--danger);\n}\n\n.room-status-dot.connecting {\n  background: var(--warning);\n}\n\n.sidebar-manage-button .ui-icon {\n  width: 16px;\n  height: 16px;\n}\n\n.connection-state.connected {\n  color: var(--success);\n}\n\n.connection-state.error,\n\n.connection-state.offline {\n  color: var(--danger);\n}\n\n.connection-state.connecting {\n  color: var(--warning);\n}\n\n.sidebar-icon-button .ui-icon {\n  width: 15px;\n  height: 15px;\n  transition: transform 160ms ease, color 160ms ease;\n}\n\n.sidebar-icon-button .ui-icon.open {\n  transform: rotate(45deg);\n}\n\n.channel-group-chevron.open {\n  transform: rotate(90deg);\n}\n\n.sidebar-item.active .channel-type-icon {\n  color: var(--accent);\n}\n\n.dm-row.active {\n  background: oklch(0.255 0.009 250);\n}\n\n.ghost-action:hover {\n  background: oklch(0.225 0.008 250 / 0.82);\n  color: var(--text);\n}\n\n.sidebar-item.active {\n  background: oklch(0.255 0.009 250);\n  color: var(--text);\n}\n\n.dm-row .dm-button.active {\n  color: var(--text);\n  background: transparent;\n}\n\n.edit-form input {\n  width: 100%;\n  color: var(--text);\n  background: var(--field-bg);\n  border: 1px solid oklch(0.50 0.012 250 / 0.12);\n  border-radius: var(--item-radius);\n  outline: none;\n}\n\n.edit-form input {\n  height: var(--field-height);\n  padding: 0 10px;\n}\n\n.edit-form input:focus {\n  border-color: oklch(0.73 0.13 40 / 0.30);\n  box-shadow: 0 0 0 2px oklch(0.73 0.13 40 / 0.10);\n}\n\n.primary-action,\n\n.ghost-action {\n  border-radius: var(--item-radius);\n  min-height: var(--control-size);\n  padding: 0 10px;\n  font-weight: 700;\n  cursor: pointer;\n  transition: background 160ms ease, color 160ms ease, opacity 160ms ease;\n}\n\n.primary-action {\n  color: oklch(0.18 0.01 40);\n  background: var(--accent);\n}\n\n.primary-action:hover {\n  background: var(--accent-hover);\n}\n\n.primary-action:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n\n.media-room {\n  min-width: 0;\n  display: grid;\n  gap: 0;\n  align-items: center;\n  padding: 0;\n  overflow: hidden;\n  border-radius: var(--item-radius);\n  background: transparent;\n}\n\n.media-room:hover,\n\n.media-room.selected,\n\n.media-room.active {\n  background: oklch(0.225 0.008 250 / 0.42);\n}\n\n.media-room.selected .media-room-join,\n\n.media-room.active .media-room-join {\n  color: var(--text);\n  background: oklch(0.255 0.009 250);\n}\n\n.ghost-action {\n  color: var(--muted);\n  background: var(--panel-bg);\n}\n\n.media-room:hover .media-room-remove {\n  opacity: 1;\n}\n\n.voice-room-icon.active {\n  color: var(--success);\n}\n\n.voice-room-status.connected {\n  color: var(--success);\n}\n\n.voice-room-status.connecting {\n  color: var(--warning);\n}\n\n.self-icon-button.active {\n  color: var(--danger);\n  background: var(--panel-bg);\n}\n\n.voice-panel.connected {\n  background: oklch(0.28 0.025 150);\n}\n\n.voice-panel.joined {\n  background: oklch(0.29 0.014 260);\n}\n\n.voice-control-button.active {\n  color: var(--text);\n  background: var(--panel-active);\n}\n\n.member-avatar {\n  width: 40px;\n  height: 40px;\n  display: inline-grid;\n  place-items: center;\n  overflow: hidden;\n  border-radius: 999px;\n  color: var(--text);\n  background: var(--accent);\n  font-size: 18px;\n  font-weight: 900;\n}\n\n.member-avatar.emoji-avatar {\n  text-shadow:\n    0 1px 2px rgb(0 0 0 / 0.86),\n    0 0 1px rgb(0 0 0 / 0.95);\n}\n\n.member-avatar img {\n  width: 100%;\n  height: 100%;\n  display: block;\n  object-fit: cover;\n}\n\n.member-avatar.small {\n  width: 28px;\n  height: 28px;\n  font-size: 13px;\n}\n\n.participant-count-many .voice-video-tile {\n  width: min(calc(25% - 12px), 320px);\n}\n\n.voice-video-placeholder .member-avatar {\n  width: 72px;\n  height: 72px;\n  font-size: 24px;\n}\n\n.message-body {\n  margin: 0;\n  color: oklch(0.86 0.005 250);\n  line-height: 1.5;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n.message-mention {\n  display: inline-block;\n  padding: 0 5px;\n  border-radius: var(--space-1);\n  background: var(--mention-bg);\n  color: var(--mention-fg);\n  font-weight: 600;\n  line-height: 1.25;\n  cursor: context-menu;\n}\n\n.message-mention:hover {\n  background: oklch(0.73 0.13 40 / 0.25);\n}\n\n.message-body-emoji {\n  font-size: 64px;\n  line-height: 1.06;\n}\n\n.message-tombstone {\n  margin: 0;\n  color: var(--quiet);\n  font-style: italic;\n  line-height: 1.45;\n}\n\n.message-markdown {\n  display: grid;\n  gap: var(--item-gap);\n}\n\n.message-markdown .md-heading {\n  margin: 0;\n  color: var(--text);\n  line-height: 1.3;\n  font-size: 15px;\n}\n\n.message-markdown a {\n  color: var(--link, oklch(0.78 0.10 230));\n  overflow-wrap: anywhere;\n}\n\n.embed-link-provider {\n  margin-right: 5px;\n  color: var(--text);\n  font-weight: 900;\n}\n\n.embed-inline-expand {\n  width: 18px;\n  height: 18px;\n  display: inline-grid;\n  place-items: center;\n  margin: 0 5px 0 0;\n  padding: 0;\n  border-radius: var(--space-1);\n  color: var(--muted);\n  background: transparent;\n  cursor: pointer;\n  vertical-align: -3px;\n}\n\n.embed-inline-expand .ui-icon {\n  width: 14px;\n  height: 14px;\n}\n\n.embed-inline-expand:hover,\n\n.embed-inline-expand:focus {\n  color: var(--text);\n  background: var(--panel-hover);\n  outline: none;\n}\n\n.message-markdown .md-code {\n  margin: 0;\n  padding: 8px 10px;\n  background: var(--field-bg);\n  border: 1px solid var(--button-border);\n  border-radius: var(--item-radius);\n  overflow-x: auto;\n  font-size: 12px;\n  line-height: 1.4;\n}\n\n.message-markdown .md-quote {\n  margin: 0;\n  padding: 2px 10px;\n  color: var(--muted);\n  border-left: 2px solid var(--button-border);\n}\n\n.message-markdown .md-list {\n  margin: 0;\n  padding-left: 20px;\n  line-height: 1.45;\n}\n\n.message-permalink {\n  color: var(--quiet);\n  font-size: 13px;\n  font-weight: 900;\n  opacity: 0.65;\n  text-decoration: none;\n}\n\n.message-permalink:hover,\n\n.message-permalink:focus {\n  color: var(--text);\n  opacity: 1;\n  outline: none;\n}\n\n.reply-preview {\n  width: min(520px, 100%);\n  min-width: 0;\n  display: grid;\n  gap: var(--space-1);\n  padding: var(--item-padding);\n  border: 1px solid oklch(0.50 0.012 250 / 0.12);\n  border-radius: var(--item-radius);\n  color: var(--muted);\n  background: var(--field-bg);\n  text-decoration: none;\n}\n\n.reply-preview:hover,\n\n.reply-preview:focus {\n  border-color: oklch(0.73 0.13 40 / 0.28);\n  color: var(--text);\n  outline: none;\n}\n\n.reply-preview span {\n  color: var(--quiet);\n  font-size: 12px;\n}\n\n.reply-preview strong {\n  min-width: 0;\n  overflow: hidden;\n  color: var(--text);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 13px;\n  font-weight: 800;\n}\n\n.reply-preview.missing {\n  color: var(--quiet);\n}\n\n.message-actions > .message-more-wrap > button {\n  min-height: var(--control-size-sm);\n  width: var(--control-size-sm);\n  display: inline-grid;\n  place-items: center;\n  padding: 0;\n  font-size: 12px;\n}\n\n.message-action-emoji {\n  font-size: 17px;\n  line-height: 1;\n}\n\n.message-action-icon .ui-icon {\n  width: 16px;\n  height: 16px;\n}\n\n.message-more-wrap {\n  position: relative;\n  display: inline-grid;\n}\n\n.message-more-menu {\n  position: absolute;\n  right: 0;\n  top: 32px;\n  z-index: 15;\n  width: 244px;\n  display: grid;\n  gap: var(--space-1);\n  padding: var(--space-2);\n}\n\n.message-more-menu.fixed {\n  position: fixed;\n  right: auto;\n  top: auto;\n}\n\n.rich-context-menu {\n  color: var(--text);\n  border: 1px solid oklch(0.58 0.010 250 / 0.28);\n  border-radius: var(--panel-radius);\n  background: oklch(0.235 0.008 250);\n  box-shadow: 0 16px 38px oklch(0.10 0.006 250 / 0.35);\n}\n\n.rich-context-menu button {\n  width: 100%;\n  min-height: var(--field-height);\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 22px;\n  gap: var(--space-3);\n  align-items: center;\n  padding: 0 var(--space-2);\n  border: 0;\n  border-radius: var(--item-radius);\n  color: var(--text);\n  background: transparent;\n  box-shadow: none;\n  cursor: pointer;\n  text-align: left;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.rich-context-menu .context-menu-header {\n  min-width: 0;\n  padding: 3px 8px 8px;\n  border-bottom: 1px solid oklch(0.58 0.010 250 / 0.16);\n  color: var(--quiet);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.rich-context-menu button:hover,\n\n.rich-context-menu button:focus {\n  color: var(--text);\n  background: oklch(0.30 0.010 250);\n  outline: none;\n}\n\n.rich-context-menu button:disabled {\n  cursor: default;\n  opacity: 0.62;\n}\n\n.rich-context-menu button:disabled:hover {\n  background: transparent;\n}\n\n.rich-context-menu button.sectioned {\n  margin-top: var(--space-2);\n  padding-top: var(--space-2);\n  border-top: 1px solid oklch(0.58 0.010 250 / 0.16);\n  border-radius: 0 0 var(--item-radius) var(--item-radius);\n}\n\n.rich-context-menu button.danger {\n  color: oklch(0.70 0.18 25);\n}\n\n.rich-context-menu button span:first-child {\n  min-width: 0;\n  display: grid;\n  gap: 1px;\n}\n\n.rich-context-menu button strong {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 13px;\n}\n\n.rich-context-menu button small {\n  color: var(--quiet);\n  font-size: 11px;\n  font-weight: 500;\n}\n\n.context-menu-icon {\n  min-width: 0;\n  color: currentColor;\n  opacity: 0.72;\n  text-align: center;\n  font-size: 17px;\n  line-height: 1;\n}\n\n.message-menu-reaction-row {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: var(--item-gap);\n  padding-bottom: var(--item-gap);\n  border-bottom: 1px solid oklch(0.58 0.010 250 / 0.16);\n}\n\n.message-menu-reaction-row button {\n  min-height: var(--row-height);\n  display: block;\n  padding: 0;\n  border-radius: var(--item-radius);\n  background: oklch(0.275 0.010 250);\n  font-size: 19px;\n  line-height: var(--row-height);\n  text-align: center;\n}\n\n.message-menu-reaction-row button:hover,\n\n.message-menu-reaction-row button:focus {\n  background: oklch(0.32 0.012 250);\n}\n\n.message-reaction-picker {\n  max-width: 380px;\n}\n\n.message-reaction-picker .matterhorn-emoji-picker {\n  --rk-emoji-bg: var(--field-bg);\n  --rk-emoji-panel: var(--panel-bg);\n  --rk-emoji-hover: var(--panel-hover);\n  --rk-emoji-border: var(--border);\n  --rk-emoji-text: var(--text);\n  --rk-emoji-muted: var(--muted);\n  --rk-emoji-accent: var(--accent-hover);\n  --rk-emoji-focus: oklch(0.62 0.18 272 / 0.18);\n  width: min(100%, 380px);\n}\n\n.message-reaction-picker .matterhorn-emoji-content {\n  max-height: 260px;\n}\n\n.message-forward-panel {\n  width: min(320px, 100%);\n  display: grid;\n  gap: var(--item-gap);\n  padding: var(--item-gap);\n  border: 1px solid oklch(0.62 0.012 250 / 0.14);\n  border-radius: var(--panel-radius);\n  background: var(--sidebar-deep);\n  box-shadow: var(--shadow);\n}\n\n.message-forward-panel > strong {\n  color: var(--muted);\n  font-size: 11px;\n  text-transform: uppercase;\n}\n\n.message-forward-list {\n  display: grid;\n  gap: var(--space-1);\n  max-height: 230px;\n  overflow: auto;\n}\n\n.message-forward-list > span {\n  color: var(--quiet);\n  font-size: 12px;\n}\n\n.message-forward-list button {\n  min-width: 0;\n  min-height: var(--field-height);\n  display: grid;\n  grid-template-columns: 54px minmax(0, 1fr);\n  gap: var(--item-gap);\n  align-items: center;\n  padding: 0 var(--space-2);\n  border-radius: var(--item-radius);\n  color: var(--muted);\n  background: var(--panel-bg);\n  cursor: pointer;\n  text-align: left;\n}\n\n.message-forward-list button:hover,\n\n.message-forward-list button:focus {\n  color: var(--text);\n  background: var(--panel-hover);\n  outline: none;\n}\n\n.message-forward-list button > span {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.embed-stack {\n  display: grid;\n  gap: 6px;\n  max-width: 520px;\n}\n\n.message-embed {\n  color: var(--muted);\n}\n\n.message-embed-card {\n  display: flex;\n  align-items: stretch;\n  gap: var(--item-gap);\n  padding: var(--space-3);\n  overflow: hidden;\n  border: 1px solid var(--border);\n  border-radius: var(--panel-radius);\n  background: var(--field-bg);\n  text-decoration: none;\n}\n\n.message-embed-inline {\n  position: relative;\n  display: block;\n  margin: 0;\n  border: 0;\n  border-radius: 0;\n  background: transparent;\n  overflow: visible;\n}\n\n.message-embed .embed-thumb {\n  width: 96px;\n  height: 64px;\n  object-fit: cover;\n  border-radius: var(--item-radius);\n  flex: 0 0 auto;\n}\n\n.embed-frame-shell {\n  position: relative;\n  display: block;\n  width: 100%;\n  min-width: 0;\n}\n\n.embed-frame,\n\n.message-embed .embed-media {\n  width: 100%;\n  display: block;\n  border: 0;\n  background: transparent;\n}\n\n.embed-frame {\n  aspect-ratio: 16 / 9;\n  min-height: 220px;\n}\n\n.message-embed-spotify .embed-frame {\n  height: 152px;\n  min-height: 152px;\n  aspect-ratio: auto;\n}\n\n.message-embed-image .embed-media {\n  max-height: 360px;\n  object-fit: contain;\n}\n\n.message-embed-video .embed-media {\n  aspect-ratio: 16 / 9;\n  object-fit: contain;\n}\n\n.message-embed-audio {\n  max-width: 520px;\n}\n\n.message-embed .embed-audio {\n  width: 100%;\n  display: block;\n}\n\n.embed-actions {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.message-embed .embed-meta {\n  display: grid;\n  gap: var(--space-1);\n  min-width: 0;\n}\n\n.message-embed strong {\n  color: var(--text);\n}\n\n.message-embed .embed-provider {\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  font-size: 10px;\n  color: var(--quiet);\n}\n\n.message-embed .embed-url {\n  overflow-wrap: anywhere;\n  font-size: 12px;\n}\n\n.embed-icon-button {\n  width: var(--control-size-sm);\n  height: var(--control-size-sm);\n  display: inline-grid;\n  place-items: center;\n  border-radius: var(--item-radius);\n  color: var(--text);\n  background: var(--panel-bg);\n  cursor: pointer;\n}\n\n.embed-icon-button .ui-icon {\n  width: 15px;\n  height: 15px;\n}\n\n.embed-icon-button:hover,\n\n.embed-icon-button:focus {\n  color: var(--text);\n  background: var(--panel-hover);\n  outline: none;\n}\n\n.message-embed-fullscreen {\n  position: fixed;\n  inset: 0;\n  z-index: 80;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  padding: var(--space-3);\n  border: 0;\n  border-radius: 0;\n  background: transparent;\n  overflow: visible;\n}\n\n.message-embed-fullscreen .embed-dialog-shroud {\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  background: oklch(0.12 0.006 260 / 0.82);\n}\n\n.message-embed-fullscreen .embed-dialog-header {\n  position: relative;\n  z-index: 1;\n  border: 1px solid var(--border);\n  border-bottom: 0;\n  border-radius: var(--panel-radius) var(--panel-radius) 0 0;\n  background: var(--panel-bg);\n}\n\n.message-embed-fullscreen .embed-frame-shell {\n  position: relative;\n  z-index: 1;\n  min-height: 0;\n  border: 1px solid var(--border);\n  border-top: 0;\n  border-radius: 0 0 var(--panel-radius) var(--panel-radius);\n  background: var(--panel-bg);\n}\n\n.message-embed-fullscreen .embed-frame,\n\n.message-embed-fullscreen .embed-media {\n  width: 100%;\n  height: 100%;\n  min-height: 0;\n  aspect-ratio: auto;\n  max-height: none;\n}\n\n.message-embed-fullscreen {\n  animation: embed-fullscreen-in 180ms ease-out forwards;\n}\n\n.message-embed-fullscreen.message-embed-fullscreen-exit {\n  animation: embed-fullscreen-out 160ms ease-in forwards;\n}\n\n@keyframes embed-fullscreen-in {\n  from {\n    opacity: 0;\n    transform: scale(0.97);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n\n@keyframes embed-fullscreen-out {\n  from {\n    opacity: 1;\n    transform: scale(1);\n  }\n  to {\n    opacity: 0;\n    transform: scale(0.97);\n  }\n}\n\n.embed-dialog-header {\n  min-width: 0;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: var(--item-gap);\n  align-items: center;\n  padding: 10px var(--space-3);\n  border-bottom: 1px solid var(--border);\n}\n\n.embed-dialog-header .embed-meta {\n  min-width: 0;\n  display: grid;\n  gap: var(--space-1);\n}\n\n.embed-dialog-header .embed-meta strong {\n  min-width: 0;\n  overflow: hidden;\n  color: var(--text);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.embed-dialog-header .embed-provider {\n  color: var(--quiet);\n  font-size: 10px;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n\n.edit-form {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto auto;\n  gap: var(--item-gap);\n}\n\n.replying-bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-3);\n  padding: var(--space-2) var(--space-3);\n  color: var(--muted);\n  background: var(--sidebar-deep);\n  border: 1px solid oklch(0.55 0.012 250 / 0.12);\n  border-bottom: 0;\n  border-radius: var(--panel-radius) var(--panel-radius) 0 0;\n  font-size: 13px;\n}\n\n.replying-bar span {\n  min-width: 0;\n  display: grid;\n  gap: 2px;\n}\n\n.replying-bar strong,\n\n.replying-bar small {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.replying-bar strong {\n  color: var(--text);\n}\n\n.replying-bar small {\n  color: var(--quiet);\n}\n\n.replying-bar button {\n  color: var(--muted);\n  background: transparent;\n  cursor: pointer;\n}\n.composer-mention {\n  background: var(--mention-bg);\n  color: var(--mention-fg);\n  font-weight: 600;\n  padding: 1px 5px;\n  border-radius: var(--space-1);\n}\n\n.mention-menu button.selected {\n  background: var(--panel-hover);\n  outline: none;\n}\n\n.composer-send-button {\n  width: var(--field-height);\n  height: var(--field-height);\n  display: inline-grid;\n  place-items: center;\n  flex: 0 0 auto;\n  color: var(--muted);\n}\n\n.composer-tool-button .ui-icon,\n\n.composer-send-button .ui-icon {\n  width: 16px;\n  height: 16px;\n}\n\n.composer-send-button {\n  border-radius: var(--item-radius);\n  background: transparent;\n  cursor: pointer;\n  transition: background 160ms ease, color 160ms ease, opacity 160ms ease;\n}\n\n.composer-send-button:not(:disabled):hover,\n\n.composer-send-button:not(:disabled):focus {\n  color: var(--text);\n  background: var(--panel-hover);\n  outline: none;\n}\n\n.composer-send-button:not(:disabled) {\n  color: oklch(0.18 0.01 40);\n  background: var(--accent);\n}\n\n.composer-send-button:not(:disabled):hover,\n\n.composer-send-button:not(:disabled):focus {\n  color: oklch(0.18 0.01 40);\n  background: var(--accent-hover);\n}\n\n.composer-send-button:disabled {\n  opacity: 0.42;\n  cursor: not-allowed;\n}\n\n.member-action.selected {\n  color: var(--text);\n  background: oklch(0.225 0.008 250 / 0.82);\n}\n\n.status-dot.online {\n  background: var(--success);\n}\n\n.status-dot.busy {\n  background: var(--danger);\n}\n\n.status-dot.away {\n  background: var(--warning);\n}\n\n@media (max-width: 599px) {\n  html,\n\n  body,\n\n  #matterhorn-mosh-root {\n    width: 100%;\n    height: 100%;\n    min-height: 100%;\n    overflow: hidden;\n    overscroll-behavior: none;\n  }\n\n  .embed-stack {\n    max-width: 100%;\n  }\n\n  .embed-dialog-header {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .message-embed-fullscreen {\n    padding: 8px;\n  }\n\n  .edit-form {\n    grid-template-columns: 1fr;\n  }\n\n  .participant-count-many .voice-video-tile {\n    grid-column: auto;\n    width: auto;\n    aspect-ratio: 1 / 1;\n    transform: none;\n  }\n\n  .voice-video-placeholder .member-avatar {\n    width: 82px;\n    height: 82px;\n    font-size: 28px;\n  }\n}\n\n/* Mosh redesign shell */\n:root {\n  --font-display: \"Bricolage Grotesque\", \"Instrument Sans\", sans-serif;\n  --font-body: \"Instrument Sans\", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  --elev-ctrl: inset 0 0 0 0.5px rgb(255 255 255 / 0.045), 0 1px 2px rgb(0 0 0 / 0.32);\n  --elev-panel: inset 0 0 0 0.5px rgb(255 255 255 / 0.04), 0 14px 36px rgb(0 0 0 / 0.3);\n}\n\nhtml,\n\nbody,\n\n#matterhorn-mosh-root {\n  width: 100%;\n  height: 100%;\n}\n\nbody {\n  color: var(--text);\n  font-family: var(--font-body);\n  font-size: 15px;\n  line-height: 1.375;\n  letter-spacing: 0.1px;\n  overflow: hidden;\n  -webkit-font-smoothing: antialiased;\n}\n\nbutton,\n\ninput,\n\nselect,\n\ntextarea {\n  color: inherit;\n  letter-spacing: inherit;\n}\n\n.chat-shell {\n  min-height: 100svh;\n  height: 100svh;\n  grid-template-columns: 272px minmax(0, 1fr) 304px;\n  overflow: hidden;\n}\n\n.sidebar-search .ui-icon {\n  position: absolute;\n  left: 10px;\n  top: 50%;\n  width: 14px;\n  height: 14px;\n  color: var(--quiet);\n  transform: translateY(-50%);\n}\n\n.sidebar-item.active {\n  background: var(--panel-active);\n}\n\n.sidebar-item.active .channel-type-icon {\n  color: var(--accent);\n}\n\n.media-room {\n  border: 0;\n  box-shadow: none;\n}\n\n.voice-member-item .member-avatar.small {\n  width: 22px;\n  height: 22px;\n}\n\n.dm-avatar-wrap .member-avatar.small {\n  width: 32px;\n  height: 32px;\n}\n\n.dm-close-button .ui-icon {\n  width: 14px;\n  height: 14px;\n}\n\n.self-identity .member-avatar {\n  width: 32px;\n  height: 32px;\n}\n\n.chat-header-button .ui-icon {\n  width: 16px;\n  height: 16px;\n}\n\n.chat-header-avatars .member-avatar.small {\n  width: 28px;\n  height: 28px;\n  margin-left: -8px;\n  border: 2.5px solid var(--chat-bg);\n}\n\n.message-row > .member-context-target .member-avatar,\n\n.message-row > .member-avatar {\n  width: 40px;\n  height: 40px;\n}\n\n.message-body {\n  color: var(--text);\n  font-size: 15px;\n  line-height: 1.45;\n}\n\n.composer-tool-button.accent {\n  color: var(--accent);\n}\n\n.composer-send-button {\n  width: auto;\n  height: 32px;\n  min-width: 72px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  padding: 0 14px;\n  color: oklch(0.18 0.05 40);\n  background: var(--accent);\n  font-size: 14px;\n  font-weight: 600;\n}\n\n.composer-send-button:disabled {\n  color: var(--quiet);\n  background: var(--field-bg);\n  opacity: 1;\n}\n\n.member-avatar-wrap .member-avatar.small {\n  width: 32px;\n  height: 32px;\n}\n\n@media (min-width: 600px) and (max-width: 1024px) {\n  .chat-shell {\n    grid-template-columns: 280px minmax(0, 1fr);\n  }\n}\n\n@media (max-width: 599px) {\n  html,\n\n  body,\n\n  #matterhorn-mosh-root {\n    width: 100%;\n    height: 100%;\n    min-height: 100%;\n    overflow: hidden;\n    overscroll-behavior: none;\n  }\n}\n\n/* Mosh source-of-truth redesign: mirrors chat.html class vocabulary. */\n:root {\n  --bg: oklch(0.205 0.007 250);\n  --surface: oklch(0.172 0.007 250);\n  --surface-deep: oklch(0.145 0.007 250);\n  --panel-hover: oklch(0.235 0.008 250);\n  --panel-active: oklch(0.258 0.01 250);\n  --field-bg: oklch(0.225 0.008 250);\n  --border: oklch(0.29 0.009 250 / 0.42);\n  --border-soft: oklch(0.27 0.009 250 / 0.24);\n  --fg: oklch(0.93 0.004 250);\n  --muted: oklch(0.68 0.01 250);\n  --quiet: oklch(0.54 0.012 250);\n  --accent: oklch(0.73 0.13 40);\n  --accent-hover: oklch(0.79 0.13 40);\n  --accent-soft: oklch(0.73 0.13 40 / 0.12);\n  --mention-fg: oklch(0.84 0.09 40);\n  --mention-bg: oklch(0.73 0.13 40 / 0.18);\n  --success: oklch(0.74 0.13 155);\n  --warning: oklch(0.80 0.12 82);\n  --danger: oklch(0.68 0.18 25);\n  --dual-light: oklch(0.72 0.004 250 / 0.46);\n  --dual-dark: oklch(0 0 0 / 0.37);\n  --elev-ctrl: inset 0 0 0 0.5px rgb(255 255 255 / 0.045), 0 1px 2px rgb(0 0 0 / 0.32);\n  --elev-panel: inset 0 0 0 0.5px rgb(255 255 255 / 0.04), 0 14px 36px rgb(0 0 0 / 0.3);\n  --font-display: \"Bricolage Grotesque\", \"Instrument Sans\", sans-serif;\n  --font-body: \"Instrument Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  --r-item: 7px;\n  --r-panel: 8px;\n  /* Legacy token aliases for backward compatibility */\n  --chat-bg: var(--bg);\n  --sidebar-bg: var(--surface);\n  --sidebar-deep: var(--surface-deep);\n  --panel-bg: var(--surface);\n  --panel-hover: var(--panel-hover);\n  --panel-active: var(--panel-active);\n  --field-bg: var(--field-bg);\n  --border: var(--border);\n  --border-soft: var(--border-soft);\n  --text: var(--fg);\n  --muted: var(--muted);\n  --quiet: var(--quiet);\n  --accent: var(--accent);\n  --accent-hover: var(--accent-hover);\n  --accent-soft: var(--accent-soft);\n  --success: var(--success);\n  --warning: var(--warning);\n  --danger: var(--danger);\n  --mention-fg: var(--mention-fg);\n  --mention-bg: var(--mention-bg);\n  --dual-border-light: var(--dual-light);\n  --dual-border-dark: var(--dual-dark);\n  --dual-light: var(--dual-light);\n  --dual-dark: var(--dual-dark);\n  --shadow: var(--elev-panel);\n  --button-border: var(--border-soft);\n  --link: oklch(0.78 0.10 230);\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-6: 24px;\n  --control-size-sm: 28px;\n  --control-size: 32px;\n  --field-height: 34px;\n  --row-height: 44px;\n  --item-gap: var(--space-2);\n  --item-padding: 7px 10px;\n  --item-radius: var(--r-item);\n  --panel-radius: var(--r-panel);\n  --sidebar-control-size: var(--control-size);\n  --sidebar-item-gap: var(--item-gap);\n  --sidebar-item-height: var(--row-height);\n  --sidebar-item-padding: var(--item-padding);\n  --sidebar-item-radius: var(--item-radius);\n}\n\nbody {\n  background: var(--bg);\n  color: var(--fg);\n  font-family: var(--font-body);\n  font-size: 15px;\n  line-height: 1.375;\n  letter-spacing: 0.1px;\n  overflow: hidden;\n  -webkit-font-smoothing: antialiased;\n}\n\nbutton,\n\ninput,\n\ntextarea {\n  color: inherit;\n  letter-spacing: inherit;\n}\n\nbutton {\n  background: none;\n  cursor: pointer;\n}\n\n.ico {\n  width: 16px;\n  height: 16px;\n  display: inline-block;\n  flex: 0 0 auto;\n  color: currentColor;\n}\n\n.ico :where(path, circle, rect, line, polyline, polygon) {\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.wordmark {\n  width: 32px;\n  height: 32px;\n  display: grid;\n  place-items: center;\n  flex: 0 0 auto;\n  color: var(--accent);\n}\n\n.wordmark .room-launch-home,\n\n.wordmark .wordmark-home {\n  width: 32px;\n  height: 32px;\n  display: grid;\n  place-items: center;\n  padding: 0;\n  color: var(--accent);\n  background: transparent;\n}\n\n.wordmark svg {\n  width: 24px;\n  height: 18px;\n  display: block;\n}\n\n.dot {\n  width: 7px;\n  height: 7px;\n  flex: 0 0 auto;\n  border-radius: 999px;\n  background: var(--quiet);\n}\n\n.dot.on {\n  background: var(--success);\n}\n\n.dot.warn {\n  background: var(--warning);\n}\n\n.dot.off {\n  background: var(--danger);\n}\n\n.conn-pill.on {\n  color: var(--success);\n}\n\n.conn-pill.warn {\n  color: var(--warning);\n}\n\n.conn-pill.off {\n  color: var(--danger);\n}\n\n.sb-search .ico {\n  position: absolute;\n  left: 10px;\n  top: 50%;\n  width: 14px;\n  height: 14px;\n  color: var(--quiet);\n  transform: translateY(-50%);\n}\n\n.group {\n  margin-bottom: 14px;\n}\n\n.chev {\n  width: 12px;\n  height: 12px;\n  color: var(--quiet);\n  transition: transform 160ms ease;\n}\n\n.chev.open {\n  transform: rotate(90deg);\n}\n\n.chan.active {\n  background: var(--panel-active);\n  color: var(--fg);\n}\n\n.chan.active .ch-ic {\n  color: var(--accent);\n}\n\n.badge {\n  min-width: 17px;\n  height: 17px;\n  display: inline-grid;\n  place-items: center;\n  padding: 0 5px;\n  border-radius: 999px;\n  background: var(--accent);\n  color: oklch(0.18 0.05 40);\n  font-size: 10px;\n  font-weight: 700;\n}\n\n.vm-av.member-avatar,\n\n.vm-av.member-avatar.small {\n  width: 22px;\n  height: 22px;\n  flex: 0 0 auto;\n}\n\n.vm-av.member-avatar img {\n  width: 100%;\n  height: 100%;\n  border-radius: 999px;\n  object-fit: cover;\n}\n\n.dm {\n  width: 100%;\n  min-height: 40px;\n  display: grid;\n  grid-template-columns: 32px minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 10px;\n  padding: 5px 8px;\n  border-radius: var(--r-item);\n  color: var(--muted);\n  text-align: left;\n  transition: background 140ms, color 140ms;\n}\n\n.dm:hover,\n\n.dm:focus,\n\n.dm.active {\n  background: var(--panel-hover);\n  color: var(--fg);\n  outline: none;\n}\n\n.dm.active {\n  background: var(--panel-active);\n}\n\n.dm-av .member-avatar,\n\n.dm-av .member-avatar.small {\n  width: 32px;\n  height: 32px;\n}\n\n.dm-stat.on {\n  background: var(--success);\n}\n\n.user-foot {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px;\n  background: var(--surface);\n}\n\n.uf-av .member-avatar {\n  width: 32px;\n  height: 32px;\n}\n\n.uf-btn.active {\n  color: var(--danger);\n}\n\n.chat {\n  position: relative;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  background: var(--bg);\n}\n\n.topic {\n  min-width: 0;\n  overflow: hidden;\n  color: var(--quiet);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 13px;\n}\n\n.topic::before {\n  content: \"|\";\n  margin: 0 8px;\n  color: var(--border);\n}\n\n.h-av.member-avatar,\n\n.h-av.member-avatar.small {\n  width: 28px;\n  height: 28px;\n  margin-left: -8px;\n  border: 2.5px solid var(--bg);\n}\n\n.h-av.member-avatar:first-child {\n  margin-left: 0;\n}\n\n.msgs {\n  min-height: 0;\n  flex: 1;\n  overflow-y: auto;\n  padding: 16px 0 8px;\n  scroll-behavior: smooth;\n}\n\n.msg {\n  display: grid;\n  grid-template-columns: 40px minmax(0, 1fr);\n  column-gap: 12px;\n  row-gap: 0;\n  position: relative;\n  padding: 8px 16px;\n}\n\n.compact-mode .msg.compact-message {\n  grid-template-columns: 28px minmax(0, 1fr);\n  column-gap: 8px;\n  padding-top: 4px;\n  padding-bottom: 4px;\n}\n\n.compact-mode .msg.compact-message .msg-av.member-avatar,\n.compact-mode .msg.compact-message .msg-av.member-avatar img {\n  width: 28px;\n  height: 28px;\n}\n\n.compact-mode .msg.compact-message .msg-head {\n  margin-bottom: 0;\n  gap: 6px;\n}\n\n.compact-mode .msg.compact-message .msg-body,\n.compact-mode .msg.compact-message .message-markdown p {\n  font-size: 14px;\n  line-height: 1.3;\n}\n\n.compact-mode .msg.compact-message .message-markdown {\n  gap: 1px;\n}\n\n.msg:hover {\n  background: oklch(0.235 0.008 250 / 0.32);\n}\n\n.msg.mentioned {\n  background: oklch(0.73 0.13 40 / 0.08);\n}\n\n.msg-av.member-avatar {\n  width: 40px;\n  height: 40px;\n  margin-top: 2px;\n}\n\n.msg-av img,\n\n.msg-av.member-avatar img {\n  width: 40px;\n  height: 40px;\n  border-radius: 999px;\n  object-fit: cover;\n}\n\n.msg-content {\n  min-width: 0;\n  display: grid;\n  justify-items: start;\n}\n\n.msg-head {\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n  margin-bottom: 2px;\n}\n\n.msg-name {\n  color: var(--fg);\n  font-size: 15px;\n  font-weight: 600;\n}\n\n.msg-name.you {\n  color: var(--accent);\n}\n\n.msg-time {\n  color: var(--quiet);\n  font-size: 11px;\n}\n\n.msg-role {\n  padding: 1px 5px;\n  border-radius: 4px;\n  background: var(--accent-soft);\n  color: var(--mention-fg);\n  font-size: 10px;\n  font-weight: 600;\n}\n\n.message-permalink {\n  color: var(--quiet);\n  opacity: 0;\n}\n\n.msg:hover .message-permalink,\n\n.message-permalink:focus {\n  opacity: 1;\n}\n\n.msg-body,\n\n.message-markdown p {\n  margin: 0;\n  color: var(--fg);\n  font-size: 15px;\n  line-height: 1.45;\n  word-wrap: break-word;\n}\n\n.message-markdown {\n  display: grid;\n  gap: 3px;\n}\n\n.mention,\n\n.message-mention {\n  padding: 0 3px;\n  border-radius: 3px;\n  background: var(--mention-bg);\n  color: var(--mention-fg);\n  font-weight: 500;\n}\n\n.msg-body code,\n\n.message-markdown code {\n  padding: 1px 5px;\n  border-radius: 4px;\n  background: var(--surface-deep);\n  color: oklch(0.84 0.02 250);\n  font-family: var(--font-mono);\n  font-size: 13px;\n}\n\n.md-code {\n  max-width: 520px;\n  margin: 6px 0 0;\n  padding: 11px 13px;\n  overflow-x: auto;\n  border: 1px solid var(--border-soft);\n  border-radius: var(--r-item);\n  background: var(--surface-deep);\n  color: oklch(0.86 0.01 250);\n  font-family: var(--font-mono);\n  font-size: 13px;\n  line-height: 1.6;\n}\n\n.reply-preview {\n  display: grid;\n  gap: 2px;\n  margin: 4px 0;\n  padding: 6px 9px;\n  border-radius: var(--r-item);\n  background: var(--surface-deep);\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.reply-preview strong {\n  min-width: 0;\n  overflow: hidden;\n  color: var(--fg);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.reactions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 5px;\n  margin-top: 5px;\n}\n\n.react {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 2px