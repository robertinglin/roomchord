	function unheldLocalMedia(mediaSettings) {
		return mediaWithVoicePreferences({
			audio: mediaSettings?.audio !== false && !input.localVoicePreferences.muted && !input.localVoicePreferences.deafened,
			video: Boolean(mediaSettings?.video),
			screen: Boolean(mediaSettings?.screen)
		}, input.localVoicePreferences);
