//#region ../matterhorn/packages/matterhorn-sdk/dist/browser/emojiPicker.js
var STYLE_ID = "matterhorn-emoji-picker-styles";
var MATTERHORN_EMOJI_SKIN_TONE_STORAGE_KEY = "matterhorn:emoji-picker:skin-tone:v1";
var SKIN_TONE_CODEPOINTS = new Set([
	"1F3FB",
	"1F3FC",
	"1F3FD",
	"1F3FE",
	"1F3FF"
]);
var SKIN_TONE_LABELS = new Set([
	"light skin tone",
	"medium-light skin tone",
	"medium skin tone",
	"medium-dark skin tone",
	"dark skin tone"
]);
var LONG_PRESS_MS = 520;
var MATTERHORN_EMOJI_PICKER_CSS = `
.matterhorn-emoji-picker {
  --rk-emoji-bg: oklch(0.98 0.006 78);
  --rk-emoji-panel: oklch(0.955 0.009 78);
  --rk-emoji-hover: oklch(0.925 0.013 78);
  --rk-emoji-border: oklch(0.82 0.016 78);
  --rk-emoji-text: oklch(0.25 0.012 70);
  --rk-emoji-muted: oklch(0.49 0.016 70);
  --rk-emoji-accent: oklch(0.48 0.13 178);
  --rk-emoji-focus: oklch(0.64 0.13 178 / 0.24);
  width: min(100%, 380px);
  box-sizing: border-box;
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr);
  overflow: hidden;
  border: 1px solid var(--rk-emoji-border);
  border-radius: 8px;
  color: var(--rk-emoji-text);
  background: var(--rk-emoji-bg);
  box-shadow: 0 18px 48px oklch(0.16 0.01 70 / 0.22);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.matterhorn-emoji-picker-floating {
  position: fixed;
  z-index: 1000;
  margin: 0;
  padding: 0;
  max-width: calc(100vw - 16px);
  max-height: calc(100vh - 16px);
}

.matterhorn-emoji-picker * {
  box-sizing: border-box;
}

.matterhorn-emoji-search-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 5px;
  padding: 8px;
  border-bottom: 1px solid var(--rk-emoji-border);
  background: var(--rk-emoji-panel);
}

.matterhorn-emoji-search {
  width: 100%;
  min-height: 34px;
  min-width: 0;
  padding: 0 10px;
  border: 1px solid var(--rk-emoji-border);
  border-radius: 6px;
  color: var(--rk-emoji-text);
  background: var(--rk-emoji-bg);
  font: inherit;
  outline: none;
}

.matterhorn-emoji-search:focus {
  border-color: var(--rk-emoji-accent);
  box-shadow: 0 0 0 3px var(--rk-emoji-focus);
}

.matterhorn-emoji-close {
  display: none;
  align-self: stretch;
  border: 1px solid var(--rk-emoji-border);
  border-radius: 6px;
  color: var(--rk-emoji-text);
  background: var(--rk-emoji-bg);
  cursor: pointer;
  font: inherit;
  padding: 0 10px;
}

.matterhorn-emoji-status {
  grid-column: 1 / -1;
  min-height: 16px;
  color: var(--rk-emoji-muted);
  font-size: 11px;
  font-weight: 750;
}

.matterhorn-emoji-tabs {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(32px, 1fr));
  gap: 3px;
  overflow: visible;
  padding: 5px;
  border-bottom: 1px solid var(--rk-emoji-border);
  background: var(--rk-emoji-bg);
}

.matterhorn-emoji-tab,
.matterhorn-emoji-button {
  border: 1px solid transparent;
  border-radius: 6px;
  color: var(--rk-emoji-text);
  background: transparent;
  cursor: pointer;
  font: inherit;
  transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
}

.matterhorn-emoji-tab {
  min-height: 34px;
  display: inline-grid;
  place-items: center;
  padding: 0 6px;
  font-size: 18px;
}

.matterhorn-emoji-tab:hover,
.matterhorn-emoji-button:hover {
  background: var(--rk-emoji-hover);
}

.matterhorn-emoji-tab:focus,
.matterhorn-emoji-button:focus {
  outline: none;
  border-color: var(--rk-emoji-accent);
  box-shadow: 0 0 0 3px var(--rk-emoji-focus);
}

.matterhorn-emoji-tab[aria-selected="true"] {
  color: var(--rk-emoji-accent);
  background: var(--rk-emoji-panel);
  border-color: var(--rk-emoji-border);
}

.matterhorn-emoji-content {
  min-height: 120px;
  max-height: 340px;
  overflow: auto;
  display: grid;
  align-content: start;
  gap: 10px;
  padding: 9px;
  background: var(--rk-emoji-bg);
}

.matterhorn-emoji-content.compact {
  min-height: 0;
  max-height: none;
}

.matterhorn-emoji-section {
  display: grid;
  gap: 5px;
}

.matterhorn-emoji-section-title {
  margin: 0;
  color: var(--rk-emoji-muted);
  font-size: 11px;
  font-weight: 850;
  text-transform: uppercase;
}

.matterhorn-emoji-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(32px, 1fr));
  gap: 3px;
}

.matterhorn-emoji-button {
  position: relative;
  min-width: 0;
  width: 100%;
  min-height: 32px;
  aspect-ratio: 1;
  display: inline-grid;
  place-items: center;
  padding: 0;
  font-size: 21px;
  line-height: 1;
}

.matterhorn-emoji-button.has-variants::after {
  content: "";
  position: absolute;
  right: 4px;
  bottom: 4px;
  border-top: 4px solid transparent;
  border-left: 4px solid var(--rk-emoji-muted);
  opacity: 0.82;
}

.matterhorn-emoji-tone-menu {
  position: fixed;
  z-index: 1001;
  width: max-content;
  max-width: min(330px, calc(100vw - 16px));
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(34px, 1fr));
  gap: 3px;
  padding: 5px;
  border: 1px solid var(--rk-emoji-border);
  border-radius: 8px;
  color: var(--rk-emoji-text);
  background: var(--rk-emoji-panel);
  box-shadow: 0 14px 36px oklch(0.16 0.01 70 / 0.28);
}

.matterhorn-emoji-tone-menu button {
  width: 34px;
  min-height: 34px;
  display: inline-grid;
  place-items: center;
  border: 1px solid transparent;
  border-radius: 6px;
  color: var(--rk-emoji-text);
  background: transparent;
  cursor: pointer;
  font: inherit;
  font-size: 22px;
  line-height: 1;
}

.matterhorn-emoji-tone-menu button:hover {
  background: var(--rk-emoji-hover);
}

.matterhorn-emoji-tone-menu button:focus {
  outline: none;
  border-color: var(--rk-emoji-accent);
  box-shadow: 0 0 0 3px var(--rk-emoji-focus);
}

.matterhorn-emoji-empty {
  margin: 0;
  padding: 22px 8px;
  color: var(--rk-emoji-muted);
  text-align: center;
  font-size: 13px;
}

@media (prefers-color-scheme: dark) {
  .matterhorn-emoji-picker {
    --rk-emoji-bg: oklch(0.22 0.008 250);
    --rk-emoji-panel: oklch(0.27 0.01 250);
    --rk-emoji-hover: oklch(0.34 0.012 250);
    --rk-emoji-border: oklch(0.42 0.013 250);
    --rk-emoji-text: oklch(0.91 0.006 250);
    --rk-emoji-muted: oklch(0.68 0.012 250);
    --rk-emoji-accent: oklch(0.68 0.15 178);
    --rk-emoji-focus: oklch(0.68 0.15 178 / 0.22);
  }
}

@media (max-width: 600px) {
  .matterhorn-emoji-picker-floating {
    inset: 0 !important;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    border: 0;
    border-radius: 0;
  }

  .matterhorn-emoji-picker-floating .matterhorn-emoji-content,
  .matterhorn-emoji-picker-floating .matterhorn-emoji-content.compact {
    min-height: 0;
    max-height: none;
  }

  .matterhorn-emoji-picker-floating .matterhorn-emoji-close {
    display: block;
  }
}
`;
function installStyles(document) {
	if (document.getElementById(STYLE_ID)) return;
	const style = document.createElement("style");
	style.id = STYLE_ID;
	style.textContent = MATTERHORN_EMOJI_PICKER_CSS;
	document.head.append(style);
}
function categoryKeys() {
	return new Set(MATTERHORN_EMOJI_CATEGORIES.map((category) => category.key));
}
function defaultCategoryKey() {
	return MATTERHORN_EMOJI_CATEGORIES[0]?.key || "";
}
function categoryLabel(categoryKey) {
	return MATTERHORN_EMOJI_CATEGORIES.find((category) => category.key === categoryKey)?.label || "Emoji";
}
function selectedCategoryKey(requested) {
	if (requested && categoryKeys().has(requested)) return requested;
	return defaultCategoryKey();
}
function storageFromWindow(window) {
	try {
		return window?.localStorage || void 0;
	} catch {
		return;
	}
}
function storageFromGlobal() {
	try {
		return globalThis.localStorage;
	} catch {
		return;
	}
}
function isSkinTone(value) {
	return value === "" || SKIN_TONE_CODEPOINTS.has(value);
}
function loadMatterhornEmojiSkinTone(storage = storageFromGlobal()) {
	try {
		const value = storage?.getItem("matterhorn:emoji-picker:skin-tone:v1") || "";
		return isSkinTone(value) ? value : "";
	} catch {
		return "";
	}
}
