//#region src/entities/chat/model/actions/threadActions.ts
function threadActions(input) {
	const { live } = input;
	async function createCommentThread(scopeType, scopeId, title) {
		const before = new Set(Object.keys(live.state.commentThreads || {}));
		const threads = ((await live.dispatch("commentsThreadCreate", {
			scopeType,
			scopeId,
			title,
			visibility: "members"
		}))?.state)?.commentThreads || live.state.commentThreads || {};
		return Object.values(threads).find((thread) => !before.has(String(thread.id)))?.id;
	}
	async function addThreadComment(threadId, body, parentId) {
		if (!body.trim()) return;
		await live.dispatch("commentsAdd", {
			threadId,
			body: body.trim(),
			...parentId ? { parentId } : {}
		});
	}
	async function editThreadComment(commentId, body) {
		if (!body.trim()) return;
		await live.dispatch("commentsEdit", {
			commentId,
			body: body.trim()
		});
	}
	async function deleteThreadComment(commentId) {
		await live.dispatch("commentsDelete", { commentId });
	}
	async function reactToThreadComment(commentId, emoji) {
		await live.dispatch("commentsReact", {
			commentId,
			emoji
		});
	}
	async function resolveCommentThread(threadId, resolved = true) {
		await live.dispatch("commentsResolve", {
			threadId,
			resolved
		});
