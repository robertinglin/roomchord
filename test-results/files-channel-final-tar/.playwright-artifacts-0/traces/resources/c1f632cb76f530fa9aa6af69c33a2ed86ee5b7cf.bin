			ui.selectDirectThread(threadId);
			return;
		}
		if (view.joinedRoomId) {
			const room = view.visibleRooms.find((item) => item.id === view.joinedRoomId);
			if (room) {
				media.updateRoomMedia(room, {
					audio: false,
					video: false,
					screen: false
				});
