//#region src/features/messages/model/recentReactions.ts
var RECENT_REACTIONS_KEY = "matterhorn:mosh:recent-reactions:v1";
var DEFAULT_RECENT_REACTIONS = [
	"👍",
	"😂",
	"❤️"
];
function uniqueRecent(items) {
	return Array.from(new Set(items.filter(Boolean))).slice(0, 3);
}
function loadRecentReactions() {
	try {
		const parsed = JSON.parse(window.localStorage.getItem(RECENT_REACTIONS_KEY) || "[]");
		if (Array.isArray(parsed)) return uniqueRecent([...parsed.filter((item) => typeof item === "string"), ...DEFAULT_RECENT_REACTIONS]);
	} catch {
		return DEFAULT_RECENT_REACTIONS;
	}
	return DEFAULT_RECENT_REACTIONS;
}
function saveRecentReactions(reactions) {
	try {
		window.localStorage.setItem(RECENT_REACTIONS_KEY, JSON.stringify(reactions));
	} catch {
		return;
	}
}
function rememberReaction(current, emoji) {
	const currentRecent = uniqueRecent([...current, ...DEFAULT_RECENT_REACTIONS]);
	const next = currentRecent.includes(emoji) ? currentRecent : uniqueRecent([emoji, ...currentRecent]);
	saveRecentReactions(next);
	return next;
}
