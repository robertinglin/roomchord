function policyRuleFromForm(id, action, match, terms, scopeId, durationMs) {
	const rule = {
		id: id.trim() || "mosh-rule",
		action,
		match,
		terms: terms.split("\n").map((term) => term.trim()).filter(Boolean)
	};
	if (scopeId.trim()) rule.scopeId = scopeId.trim();
	const duration = Number(durationMs);
	if (Number.isFinite(duration) && duration > 0) rule.durationMs = duration * 1e3;
	return rule;
}
