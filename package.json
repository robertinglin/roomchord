{
  "name": "mosh",
  "version": "0.1.0",
  "description": "Mosh Matterhorn chat app with channels, private messages, presence, camera-capable rooms, and screen-share state.",
  "type": "commonjs",
  "main": "src/sdk-app.cjs",
  "exports": {
    ".": "./src/sdk-app.cjs",
    "./sdk-app": "./src/sdk-app.cjs",
    "./types": {
      "types": "./types.d.ts",
      "default": "./types.d.ts"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "coverage": "pnpm run coverage:node && pnpm run coverage:frontend",
    "coverage:node": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test-coverage-include=mosh.cjs --test-coverage-include=shared/*.cjs --test-coverage-include=shared/**/*.cjs test/*.test.cjs",
    "coverage:frontend": "vitest run --config vitest.config.ts src --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.include=src/features/attachments/** --coverage.include=src/features/search/** --coverage.include=src/features/community/** --coverage.include=src/features/custom-media/ui/CustomMediaCatalog.tsx --coverage.include=src/features/custom-media/model/customMediaMessage.ts --coverage.include=src/features/direct-messages/ui/DirectMessages.tsx --coverage.include=src/features/personal-productivity/model/usePersonalProductivity.ts --coverage.include=src/features/personal-productivity/ui/PersonalProductivityPanel.tsx --coverage.include=src/features/management/ui/manage/AutoModControls.tsx --coverage.include=src/features/management/ui/manage/SafetyControls.tsx --coverage.include=src/features/management/ui/manage/ManageBotsTab.tsx --coverage.include=src/features/management/ui/manage/ManageCommunityTab.tsx --coverage.include=src/features/management/ui/manage/ManageIntegrationsTab.tsx --coverage.include=src/features/messages/model/useRoomHistory.ts --coverage.include=src/features/messages/ui/MessageComposer.tsx --coverage.include=src/features/messages/ui/MessageFeed.tsx --coverage.include=src/features/messages/ui/MessageRow.tsx --coverage.include=src/features/user-controls/ui/VoiceSettingsDialog.tsx --coverage.include=src/features/voice-room/model/voiceModeration.ts --coverage.include=src/features/voice-room/model/voiceParticipants.ts --coverage.include=src/features/voice-room/ui/VoiceParticipantGrid.tsx --coverage.include=src/features/voice-room/ui/VoiceRoomView.tsx --coverage.include=src/features/channel-navigation/ui/ChannelContextMenus.tsx --coverage.include=src/shared/ui/Attachment*.tsx --coverage.include=src/shared/ui/NotificationControlsMenu.tsx --coverage.include=src/shared/ui/ThreadPanel.tsx --coverage.include=src/entities/chat/model/actions/communityActions.ts --coverage.include=src/entities/chat/model/actions/directThreadActions.ts --coverage.include=src/entities/chat/model/actions/messageActions.ts --coverage.include=src/entities/chat/model/actions/safetyActions.ts --coverage.include=src/entities/chat/model/actions/threadActions.ts --coverage.include=src/entities/chat/model/actions/voiceModerationActions.ts --coverage.include=src/entities/chat/model/chatActions.ts --coverage.include=src/entities/chat/model/chatRuntime.tsx --coverage.include=src/entities/chat/model/chatUiStore.ts --coverage.include=src/entities/chat/model/chatViewModel.ts --coverage.include=src/entities/chat/model/state.ts --coverage.include=src/entities/chat/model/useChatViewData.ts --coverage.include=src/entities/chat/model/useNotificationPreferences.ts --coverage.include=src/entities/chat/model/usePersonalUnread.ts --coverage.include=src/entities/chat/ui/VoiceSettingsPanel.tsx --coverage.include=src/widgets/chat-shell/ui/ChatContent.tsx --coverage.thresholds.lines=80 --coverage.thresholds.functions=80 --coverage.thresholds.branches=80 --coverage.thresholds.statements=80",
    "dev:frontend": "vite --config vite.config.ts --host 127.0.0.1 --port 42732 --strictPort",
    "build:frontend": "node shared/frontendCommand.cjs build .",
    "build:frontend:watch": "node shared/frontendCommand.cjs watch .",
    "serve:frontend": "vite preview --config vite.config.ts",
    "check:frontend": "tsc --project tsconfig.json",
    "check:fsd": "dependency-cruise --config .dependency-cruiser.cjs --validate --output-type err src",
    "build": "pnpm run build:frontend",
    "check": "pnpm run check:frontend && pnpm run check:fsd",
    "test:frontend": "vitest run --config vitest.config.ts src",
    "test:e2e": "playwright test -c playwright.config.cjs",
    "test:e2e:chromium": "playwright test -c playwright.config.cjs --project=chromium",
    "test:e2e:smoke": "playwright test -c playwright.config.cjs --project=firefox --project=webkit --grep @smoke",
    "bot:lfm": "pnpm --dir services/lfm-bot start",
    "bot:lfm:demo": "pnpm --dir services/lfm-bot demo:two-bots",
    "bot:lfm:test": "pnpm --dir services/lfm-bot test",
    "dev": "matterhorn ./mosh.cjs mosh_live_room --serve dev"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "matterhorn-sdk": "link:../matterhorn/packages/matterhorn-sdk",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "engines": {
    "node": ">=22.12"
  },
  "matterhorn": {
    "app": "./src/sdk-app.cjs"
  },
  "devDependencies": {
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/rollup-plugin": "^0.19.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.9",
    "dependency-cruiser": "^17.4.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.8.0"
}
